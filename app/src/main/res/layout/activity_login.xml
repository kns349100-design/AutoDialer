<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_chip">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="&#128172;"
                android:textSize="28sp"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Log in"
            android:textColor="#16213E"
            android:textStyle="bold"
            android:textSize="24sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="with Phone Number + PIN"
            android:textColor="#8A8FA3"
            android:textSize="13sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_light"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:text="&#127470;&#127475; +91"
                android:textColor="#16213E"
                android:textSize="15sp"/>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#E3E8F2"/>

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:maxLength="10"
                android:hint="Phone number"
                android:textColor="#16213E"
                android:textColorHint="#B0B5C4"
                android:background="@android:color/transparent"
                android:padding="14dp"
                android:textSize="15sp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:hint="4-digit PIN"
            android:textColor="#16213E"
            android:textColorHint="#B0B5C4"
            android:textSize="18sp"
            android:letterSpacing="0.3"
            android:gravity="center"
            android:background="@drawable/bg_input_light"
            android:padding="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="First time? This PIN will be set as yours."
            android:textColor="#8A8FA3"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_login_button"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:text="Log In"/>

        <TextView
            android:id="@+id/btnForgotPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Forgot PIN?"
            android:textColor="#2E7CF6"
            android:textSize="13sp"/>

        <LinearLayout
            android:id="@+id/resetSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="18dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E3E8F2"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set a new PIN"
                android:textColor="#16213E"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etNewPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:hint="New 4-digit PIN"
                android:textColor="#16213E"
                android:textColorHint="#B0B5C4"
                android:textSize="18sp"
                android:letterSpacing="0.3"
                android:gravity="center"
                android:background="@drawable/bg_input_light"
                android:padding="16dp"/>

            <TextView
                android:id="@+id/btnResetPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_login_button"
                android:gravity="center"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:text="Reset PIN"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvLoginStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#8A8FA3"
            android:textSize="12sp"
            android:gravity="center"
            android:text=""/>

    </LinearLayout>
</ScrollView>
