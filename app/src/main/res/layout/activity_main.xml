<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="86dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="AutoDialer"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/btnSheets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_avatar"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="11sp"
                    android:text="Sheets"/>

                <TextView
                    android:id="@+id/btnDashboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_avatar"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="11sp"
                    android:text="Dashboard"/>

                <TextView
                    android:id="@+id/btnSubscription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_resume"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/resume_text"
                    android:textSize="11sp"
                    android:text="Plan"/>
            </LinearLayout>

            <!-- Gradient hero card: session progress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hero_gradient"
                android:padding="20dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tvSessionName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D8CCF5"
                    android:textSize="12sp"
                    android:text="Session: (not started)"/>

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="30sp"
                    android:text="0 / 0"/>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="14dp"
                    android:progressTint="#FFFFFF"
                    android:progressBackgroundTint="#40FFFFFF"
                    android:max="100"
                    android:progress="0"/>

                <TextView
                    android:id="@+id/tvCounts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#D8CCF5"
                    android:textSize="12sp"
                    android:text="Pending: 0  Completed: 0  Skipped: 0"/>
            </LinearLayout>

            <!-- Current call card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvCurrentLead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="18sp"
                    android:text="No active call"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary_dark"
                    android:text="Status: Ready"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Paste numbers here (one per line). Optional name: Rahul, 9876543210"
                android:textColor="@color/text_muted_dark"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etNumbers"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top|start"
                android:hint="9876543210&#10;Rahul, 9123456780&#10;..."
                android:inputType="textMultiLine"
                android:background="@drawable/bg_card"
                android:textColor="@color/text_primary_dark"
                android:textColorHint="@color/text_muted_dark"
                android:padding="12dp"
                android:layout_marginTop="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/btnPasteClipboard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:padding="10dp"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="11sp"
                    android:text="Paste Clipboard"/>

                <TextView
                    android:id="@+id/btnImportFile"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:padding="10dp"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="11sp"
                    android:text="File Upload"/>

                <TextView
                    android:id="@+id/btnImportImage"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:padding="10dp"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="11sp"
                    android:text="Image Upload"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btnLoadList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_load_idle"
                android:gravity="center"
                android:padding="10dp"
                android:textColor="@color/resume_text"
                android:textSize="11sp"
                android:text="Load List"/>

            <TextView
                android:id="@+id/btnRemoveList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_remove_list"
                android:gravity="center"
                android:padding="10dp"
                android:textColor="@color/no_bg"
                android:textSize="11sp"
                android:visibility="gone"
                android:text="Remove Current List"/>

            <TextView
                android:id="@+id/tvDuplicateInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/no_bg"
                android:textSize="11sp"
                android:text=""/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp"
                    android:text="Batch target (number of calls; 0 = all):"/>

                <EditText
                    android:id="@+id/etBatchTarget"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="0"
                    android:textColor="@color/text_primary_dark"
                    android:textColorHint="@color/text_muted_dark"
                    android:background="@drawable/bg_card"
                    android:padding="8dp"
                    android:gravity="center"/>
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbConsent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary_dark"
                android:text="These are all consenting/authorized contacts"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/btnManageOutcomes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text_secondary_dark"
                android:textSize="11sp"
                android:text="+ Custom Call Option"/>

            <TextView
                android:id="@+id/tvResumeBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="10dp"
                android:background="@drawable/bg_pill_info"
                android:textColor="@color/info_text"
                android:visibility="gone"
                android:text="Previous session found - tap to resume"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Numbers"
                android:textColor="@color/text_primary_dark"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNumbers"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Fixed bottom dock: primary call controls (matches reference app's bottom nav pattern) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/bg_dock"
        android:padding="12dp"
        android:gravity="center">

        <TextView
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_dock_icon_resume"
            android:gravity="center"
            android:padding="14dp"
            android:textColor="@color/resume_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="Start"/>

        <TextView
            android:id="@+id/btnPause"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_dock_icon"
            android:gravity="center"
            android:padding="14dp"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp"
            android:text="Pause"/>

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_dock_icon"
            android:gravity="center"
            android:padding="14dp"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp"
            android:text="Skip"/>

        <TextView
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dock_icon_no"
            android:gravity="center"
            android:padding="14dp"
            android:textColor="@color/no_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="STOP"/>
    </LinearLayout>

    <!-- Full-screen glowing outcome overlay - rows built dynamically at runtime so any
         number of options (defaults + custom) fit and adjust automatically -->
    <LinearLayout
        android:id="@+id/overlayOutcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="20dp"
        android:background="#0A0A0B">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Call ended — choose an option"
            android:textColor="@color/text_muted_dark"
            android:textSize="13sp"/>

        <LinearLayout
            android:id="@+id/outcomeButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"/>
    </LinearLayout>

    <!-- Small always-visible floating Stop button - stays on top regardless of scroll,
         so the calling process can be stopped instantly from anywhere on screen -->
    <TextView
        android:id="@+id/btnFloatingStop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_pill_no"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:textColor="@color/no_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:elevation="10dp"
        android:visibility="gone"
        android:text="⏹ Stop"/>

</FrameLayout>
