<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvSessionName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Session: (not started)"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/btnDashboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_avatar"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="12sp"
                    android:text="Dashboard"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Progress"
                        android:textColor="@color/text_muted_dark"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/tvProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Progress: 0 / 0"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:progressTint="@color/progress_fill"
                    android:progressBackgroundTint="@color/progress_track"
                    android:max="100"
                    android:progress="0"/>

                <TextView
                    android:id="@+id/tvCounts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp"
                    android:text="Pending: 0  Completed: 0  Skipped: 0"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvCurrentLead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="18sp"
                    android:text="No active call"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary_dark"
                    android:text="Status: Ready"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Numbers paste karo (ek line me). Optional naam: Rahul, 9876543210"
                android:textColor="@color/text_muted_dark"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etNumbers"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top|start"
                android:hint="9876543210&#10;Rahul, 9123456780&#10;..."
                android:inputType="textMultiLine"
                android:background="@drawable/bg_card"
                android:textColor="@color/text_primary_dark"
                android:textColorHint="@color/text_muted_dark"
                android:padding="12dp"
                android:layout_marginTop="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/btnPasteClipboard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:padding="10dp"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="11sp"
                    android:text="Paste Clipboard"/>

                <TextView
                    android:id="@+id/btnImportFile"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:padding="10dp"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="11sp"
                    android:text="File Upload"/>

                <TextView
                    android:id="@+id/btnLoadList"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_resume"
                    android:gravity="center"
                    android:padding="10dp"
                    android:textColor="@color/resume_text"
                    android:textSize="11sp"
                    android:text="List Load"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDuplicateInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/no_bg"
                android:textSize="11sp"
                android:text=""/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp"
                    android:text="Batch target (kitne calls; 0 = sab):"/>

                <EditText
                    android:id="@+id/etBatchTarget"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="0"
                    android:textColor="@color/text_primary_dark"
                    android:textColorHint="@color/text_muted_dark"
                    android:background="@drawable/bg_card"
                    android:padding="8dp"
                    android:gravity="center"/>
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbConsent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary_dark"
                android:text="Ye sab consenting/authorized contacts hain"
                android:textSize="12sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_resume"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/resume_text"
                    android:textSize="12sp"
                    android:text="Start"/>

                <TextView
                    android:id="@+id/btnPause"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp"
                    android:text="Pause"/>

                <TextView
                    android:id="@+id/btnSkip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp"
                    android:text="Skip"/>

                <TextView
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_no"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/no_text"
                    android:textSize="12sp"
                    android:text="STOP"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvResumeBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="10dp"
                android:background="@drawable/bg_pill_info"
                android:textColor="@color/info_text"
                android:visibility="gone"
                android:text="Pichla session mila - Resume Session dabao"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNumbers"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/overlayOutcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="20dp"
        android:background="#0A0A0B">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Call khatam — agla option chuno"
            android:textColor="@color/text_muted_dark"
            android:textSize="13sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnOutcomeResume"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_glow_box_resume"
                android:gravity="center"
                android:elevation="16dp"
                android:textColor="@color/resume_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="RESUME"/>

            <TextView
                android:id="@+id/btnOutcomeNo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_glow_box_no"
                android:gravity="center"
                android:elevation="16dp"
                android:textColor="@color/no_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="NO"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnOutcomePositive"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_glow_box_positive"
                android:gravity="center"
                android:elevation="16dp"
                android:textColor="@color/positive_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="POSITIVE"/>

            <TextView
                android:id="@+id/btnOutcomeInfo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_glow_box_info"
                android:gravity="center"
                android:elevation="16dp"
                android:textColor="@color/info_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="INFO"/>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
