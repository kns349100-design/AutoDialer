<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Custom Call Options"
        android:textStyle="bold"
        android:textColor="@color/text_primary_dark"
        android:textSize="16sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Type a new label - the app picks a color automatically"
        android:textColor="@color/text_muted_dark"
        android:textSize="11sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etNewOutcomeLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="e.g. Callback, Wrong Number"
            android:textColor="@color/text_primary_dark"
            android:textColorHint="@color/text_muted_dark"
            android:background="@drawable/bg_card"
            android:padding="10dp"/>

        <TextView
            android:id="@+id/btnAddOutcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_resume"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/resume_text"
            android:text="Add"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/existingOutcomesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/btnCloseManageOutcomes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/text_secondary_dark"
        android:text="Close"/>

</LinearLayout>
